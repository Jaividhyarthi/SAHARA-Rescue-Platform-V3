import CallPanel from './CallPanel';
import {useCallback,useEffect,useRef,useState} from 'react';
import {Activity,ArrowRight,Bell,Check,CheckCircle2,ChevronDown,ClipboardList,Clock,Compass,HeartHandshake,Home,Layers,LifeBuoy,LocateFixed,LogOut,MapPin,MessageCircle,Navigation,Phone,Plus,Radio,RefreshCw,Route,Search,Send,Shield,ShieldCheck,Siren,Square,Star,Users,Wifi,Zap} from 'lucide-react';
import L from 'leaflet';import 'leaflet/dist/leaflet.css';
type User={id:string;name:string;email:string;role:string;points:number};
type Mission={id:string;resident_id:string;volunteer_id:string|null;category:string;description:string;priority:string;status:string;latitude:number|null;longitude:number|null;created_at:string};
type Point={latitude:number;longitude:number;accuracy?:number};type Tracking={resident:Point|null;volunteer:Point|null;status:string};
const API=import.meta.env.VITE_API_URL||'http://127.0.0.1:8000';
async function request(path:string,method='GET',body?:unknown,token?:string){const res=await fetch(API+path,{method,headers:{'Content-Type':'application/json',...(token?{Authorization:'Bearer '+token}:{})},...(body!==undefined?{body:JSON.stringify(body)}:{})});const json=await res.json().catch(()=>({}));if(!res.ok)throw Error(json.detail||'Request failed');return json;}
const categories=['Medical assistance','Food & water','Safe transport','Shelter & supplies','Urgent assistance'];
const label=(s:string)=>s.replace(/_/g,' ').replace(/^./,c=>c.toUpperCase());
const fmt=(s:string)=>new Date(s).toLocaleString('en-IN',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});
function gps():Promise<Point>{return new Promise((resolve,reject)=>{if(!navigator.geolocation)return reject(Error('Geolocation not available'));navigator.geolocation.getCurrentPosition(p=>resolve({latitude:p.coords.latitude,longitude:p.coords.longitude,accuracy:p.coords.accuracy}),e=>reject(Error(e.message)),{enableHighAccuracy:true,timeout:12000,maximumAge:0});});}
function MapCanvas({resident,volunteer,missions=[]}:{resident?:Point|null;volunteer?:Point|null;missions?:Mission[]}){
 const node=useRef<HTMLDivElement>(null);const map=useRef<L.Map|null>(null);
 useEffect(()=>{if(!node.current)return;const instance=L.map(node.current,{zoomControl:false,scrollWheelZoom:false});map.current=instance;L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap © CARTO',maxZoom:19}).addTo(instance);L.control.zoom({position:'bottomright'}).addTo(instance);return()=>{instance.remove();map.current=null};},[]);
 useEffect(()=>{const m=map.current;if(!m)return;m.eachLayer(layer=>{if(!(layer instanceof L.TileLayer))m.removeLayer(layer)});const bounds:L.LatLngExpression[]=[];const pin=(p:Point,text:string,color:string)=>{const ll:L.LatLngExpression=[p.latitude,p.longitude];bounds.push(ll);L.circleMarker(ll,{radius:10,color:'#fff',weight:2,fillColor:color,fillOpacity:1}).addTo(m).bindPopup(text)};missions.filter(x=>x.latitude!=null&&x.longitude!=null).forEach(x=>pin({latitude:x.latitude!,longitude:x.longitude!},x.category+' · '+label(x.status),x.status==='pending'?'#f5a84d':'#fa5c68'));if(resident)pin(resident,'SOS location','#fa5c68');if(volunteer)pin(volunteer,'Volunteer live location','#31d9b2');if(resident&&volunteer)L.polyline([[resident.latitude,resident.longitude],[volunteer.latitude,volunteer.longitude]],{color:'#42e5cf',weight:3,dashArray:'6 7'}).addTo(m);if(bounds.length>1)m.fitBounds(L.latLngBounds(bounds),{padding:[50,50],maxZoom:14});else if(bounds.length)m.setView(bounds[0],14);else m.setView([13.08,80.27],10);},[resident?.latitude,resident?.longitude,volunteer?.latitude,volunteer?.longitude,JSON.stringify(missions)]);
 return <div className="map-canvas" ref={node}/>;
}
export default function App(){
 const [token,setToken]=useState(()=>sessionStorage.getItem('sahara_token')||'');const [user,setUser]=useState<User|null>(null);const [view,setView]=useState('overview');const [authMode,setAuthMode]=useState<'login'|'register'>('login');const [role,setRole]=useState('resident');const [name,setName]=useState('');const [email,setEmail]=useState('');const [password,setPassword]=useState('');const [missions,setMissions]=useState<Mission[]>([]);const [offers,setOffers]=useState<{id:string;mission:Mission}[]>([]);const [selected,setSelected]=useState<Mission|null>(null);const [tracking,setTracking]=useState<Tracking|null>(null);const [sharing,setSharing]=useState(false);const [available,setAvailable]=useState(false);const [command,setCommand]=useState<{missions:Mission[];volunteers:User[]}|null>(null);const [category,setCategory]=useState('Medical assistance');const [description,setDescription]=useState('');const [priority,setPriority]=useState('high');const [messages,setMessages]=useState<{id:string;body:string;sender_id:string;created_at:string}[]>([]);const [draft,setDraft]=useState('');const [busy,setBusy]=useState(false);const [notice,setNotice]=useState('');const [filter,setFilter]=useState('all');const [route,setRoute]=useState<{distance:number;duration:number;coordinates:[number,number][]}|null>(null);
 const api=useCallback((path:string,method='GET',body?:unknown)=>request(path,method,body,token),[token]);
 const refresh=useCallback(async()=>{if(!token)return;try{const [me,items]=await Promise.all([api('/auth/me'),api('/missions')]);setUser(me);setMissions(items);if(me.role==='coordinator')setCommand(await api('/command'));if(me.role==='volunteer')setOffers(await api('/offers'));}catch(e){if((e as Error).message.includes('expired')||(e as Error).message.includes('Sign in')){setToken('');sessionStorage.removeItem('sahara_token');}}},[api,token]);
 useEffect(()=>{void refresh();const id=window.setInterval(()=>void refresh(),15000);return()=>clearInterval(id)},[refresh]);
 useEffect(()=>{if(!selected)return;let active=true;const load=async()=>{try{const [t,m]=await Promise.all([api('/missions/'+selected.id+'/tracking'),api('/missions/'+selected.id+'/messages')]);if(active){setTracking(t);setMessages(m)}}catch{}};void load();const id=setInterval(()=>void load(),12000);return()=>{active=false;clearInterval(id)}},[selected?.id,api]);
 useEffect(()=>{if(!sharing||!selected||user?.role!=='volunteer')return;let active=true;const update=async()=>{try{const p=await gps();if(active)await api('/missions/'+selected.id+'/tracking','PUT',p)}catch(e){if(active){setNotice((e as Error).message);setSharing(false)}}};void update();const id=setInterval(()=>void update(),20000);return()=>{active=false;clearInterval(id)}},[sharing,selected?.id,user?.role,api]);
 useEffect(()=>{if(!tracking?.resident||!tracking.volunteer){setRoute(null);return}const controller=new AbortController();const a=tracking.volunteer,b=tracking.resident;fetch(`https://router.project-osrm.org/route/v1/driving/${a.longitude},${a.latitude};${b.longitude},${b.latitude}?overview=full&geometries=geojson`,{signal:controller.signal}).then(r=>r.json()).then(x=>{if(x.routes?.[0])setRoute(x.routes[0]);else setRoute(null)}).catch(()=>setRoute(null));return()=>controller.abort()},[tracking?.resident?.latitude,tracking?.volunteer?.latitude,tracking?.resident?.longitude,tracking?.volunteer?.longitude]);
 async function run(fn:()=>Promise<void>){setBusy(true);setNotice('');try{await fn()}catch(e){setNotice((e as Error).message)}finally{setBusy(false)}}
 async function auth(e:React.FormEvent){e.preventDefault();await run(async()=>{const data=await request(authMode==='login'?'/auth/login':'/auth/register','POST',authMode==='login'?{email,password}:{name,email,password,role});sessionStorage.setItem('sahara_token',data.token);setToken(data.token);setUser(data.user);setView('overview')})}
 async function create(sos=false){await run(async()=>{let p:Point|undefined;try{p=await gps()}catch(e){if(sos&&!confirm('GPS unavailable. Submit without nearby volunteer matching?'))return}const data=await api('/missions','POST',{category:sos?'Urgent assistance':category,description:sos?'SOS assistance requested. Please contact the resident through the mission conversation.':description,priority:sos?'critical':priority,...p});setDescription('');setNotice('Request recorded. Volunteers must accept before assignment.');await refresh();setSelected(data);setView('detail')})}
 async function togglePresence(){await run(async()=>{const p=await gps();await api('/presence','PUT',{...p,available:!available});setAvailable(!available);setNotice(!available?'Available for matching for 15 minutes. Refresh availability to renew.':'Marked unavailable')})}
 async function stopSharing(){setSharing(false);if(selected)await run(async()=>{await api('/missions/'+selected.id+'/tracking','DELETE');setNotice('Location sharing stopped')})}
 async function updateStatus(status:string){if(!selected)return;await run(async()=>{const m=await api('/missions/'+selected.id+'/status','PATCH',{status});setSelected(m);if(['confirmed','cancelled'].includes(status))setSharing(false);await refresh()})}
 async function sendMessage(e:React.FormEvent){e.preventDefault();if(!selected||!draft.trim())return;await run(async()=>{await api('/missions/'+selected.id+'/messages','POST',{body:draft.trim()});setDraft('');setMessages(await api('/missions/'+selected.id+'/messages'))})}
 async function enableNotifications(){await run(async()=>{if(!('serviceWorker' in navigator)||!('PushManager' in window))throw Error('Push is not supported in this browser');const config=await request('/push/config');if(!config.enabled)throw Error('Set VAPID keys in backend .env first');const permission=await Notification.requestPermission();if(permission!=='granted')throw Error('Notification permission denied');const worker=await navigator.serviceWorker.register('/sw.js');const sub=await worker.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:Uint8Array.from(atob(config.public_key.replace(/-/g,'+').replace(/_/g,'/')),c=>c.charCodeAt(0))});const info=sub.toJSON();await api('/push/subscribe','POST',{endpoint:info.endpoint,keys:info.keys});setNotice('Push notifications enabled on this browser')})}
 const nav=[{id:'overview',icon:Home,text:'Overview'},{id:'missions',icon:ClipboardList,text:'Missions'},{id:'map',icon:Layers,text:'Response map'},{id:'messages',icon:MessageCircle,text:'Messages'},{id:'impact',icon:Star,text:'Impact & rewards'},{id:'safety',icon:ShieldCheck,text:'Safety center'}];
 const all=user?.role==='coordinator'?(command?.missions||[]):missions;const pending=all.filter(x=>x.status==='pending').length;const active=all.filter(x=>['assigned','in_progress'].includes(x.status)).length;const completed=all.filter(x=>x.status==='confirmed').length;
 if(!token||!user)return <div className="auth-shell"><div className="auth-visual"><div className="brand big"><div className="brand-icon"><HeartHandshake size={27}/></div><div>SAHARA<small>RESCUE INTELLIGENCE</small></div></div><div className="auth-headline"><div className="eyebrow"><span className="live-dot"/> COMMUNITY RESPONSE, REIMAGINED</div><h1>Every second<br/><em>matters.</em><br/>Every person<br/>counts.</h1><p>A beautifully connected rescue coordination workspace for communities, volunteers and response teams.</p></div><div className="auth-bottom"><span><ShieldCheck size={17}/> Privacy-aware</span><span><Radio size={17}/> Location-enabled</span><span><HeartHandshake size={17}/> Human-first</span></div></div><div className="auth-form-wrap"><div className="auth-card"><div className="mobile-brand"><HeartHandshake/> SAHARA</div><div className="eyebrow">WELCOME TO SAHARA</div><h2>{authMode==='login'?'Good to have you back.':'Join the response network.'}</h2><p className="muted">{authMode==='login'?'Sign in to your secure workspace.':'Create a resident or volunteer account.'}</p><form onSubmit={auth}>{authMode==='register'&&<label>Full name<input required minLength={2} value={name} onChange={e=>setName(e.target.value)} placeholder="Your full name"/></label>}<label>Email address<input type="email" required value={email} onChange={e=>setEmail(e.target.value)} placeholder="you@example.com"/></label><label>Password<input type="password" required minLength={8} value={password} onChange={e=>setPassword(e.target.value)} placeholder="At least 8 characters"/></label>{authMode==='register'&&<label>I'm joining as<select value={role} onChange={e=>setRole(e.target.value)}><option value="resident">Resident</option><option value="volunteer">Volunteer</option></select></label>}<button className="primary wide" disabled={busy}>{busy?'Please wait...':authMode==='login'?'Sign in to SAHARA':'Create account'} <ArrowRight size={17}/></button></form><div className="auth-switch">{authMode==='login'?'New to SAHARA?':'Already have an account?'} <button onClick={()=>setAuthMode(authMode==='login'?'register':'login')}>{authMode==='login'?'Create an account':'Sign in'}</button></div>{notice&&<div className="notice error">{notice}</div>}<div className="auth-disclaimer"><Shield size={16}/> Prototype only — not an emergency response service. For immediate danger in India call <a href="tel:112">112</a>.</div></div></div></div>;
 return <div className="shell"><aside className="sidebar"><div className="brand"><div className="brand-icon"><HeartHandshake size={23}/></div><div>SAHARA<small>RESCUE INTELLIGENCE</small></div></div><div className="workspace-tag">WORKSPACE <span className="tag">{user.role}</span></div><nav>{nav.map(x=><button key={x.id} className={'nav-item '+(view===x.id?'active':'')} onClick={()=>{setView(x.id);setSelected(null)}}><x.icon size={19}/>{x.text}{x.id==='missions'&&active>0&&<span className="nav-count">{active}</span>}</button>)}</nav><div className="sidebar-spacer"/><div className="support-card"><div className="support-icon"><LifeBuoy size={21}/></div><strong>Built for human connection.</strong><p>Community support is not a replacement for official emergency services.</p><a href="tel:112">Emergency: 112 <ArrowRight size={14}/></a></div><button className="account" onClick={()=>{sessionStorage.removeItem('sahara_token');setToken('');setUser(null)}}><span className="avatar">{user.name.slice(0,2).toUpperCase()}</span><span><strong>{user.name}</strong><small>{label(user.role)}</small></span><LogOut size={17}/></button></aside><div className="main"><header className="topbar"><div className="breadcrumb">SAHARA <span>/</span> {view==='detail'?'Mission details':label(view)}</div><div className="top-actions"><button className="outline" title="Enable browser push notifications" onClick={()=>void enableNotifications()}><Bell size={15}/> Alerts</button><span className="online"><span className="live-dot"/> SYSTEM ONLINE</span><span className="top-sep"/><span className="time">{new Date().toLocaleDateString('en-IN',{month:'short',day:'numeric',year:'numeric'})}</span><span className="avatar small">{user.name.slice(0,2).toUpperCase()}</span></div></header><main className="content">{notice&&<div className="notice"><span>{notice}</span><button onClick={()=>setNotice('')}>×</button></div>}
 {view==='overview'&&<><div className="hero"><div><div className="eyebrow"><span className="live-dot"/> LIVE COMMUNITY RESPONSE</div><h1>Good to see you, {user.name.split(' ')[0]}<span className="spark">✳</span></h1><p>{user.role==='volunteer'?'Your willingness to help makes every mission possible.':user.role==='coordinator'?'Your command center for coordinated community response.':'Help is closer when communities are connected.'}</p></div><div className="hero-actions">{user.role==='resident'?<button className="sos-button" onClick={()=>{if(confirm('Send an SOS assistance request? This is not official emergency dispatch.'))void create(true)}} disabled={busy}><Siren size={20}/> SEND SOS</button>:<button className="primary" onClick={()=>setView('map')}><Compass size={18}/> Open command map</button>}</div></div><div className="stat-grid"><Stat icon={ClipboardList} label="Total missions" value={all.length} tint="mint"/><Stat icon={Activity} label="Active responses" value={active} tint="blue"/><Stat icon={Clock} label="Awaiting action" value={pending} tint="amber"/><Stat icon={CheckCircle2} label="Verified outcomes" value={completed} tint="purple"/></div>{user.role==='volunteer'&&<div className="availability"><div><div className="availability-icon"><Radio size={21}/></div><div><strong>Volunteer availability</strong><p>Share your location for 15-minute nearby matching.</p></div></div><button className={available?'outline':'primary'} disabled={busy} onClick={()=>void togglePresence()}>{available?'Go unavailable':'Go available'} <ArrowRight size={16}/></button></div>}{user.role==='volunteer'&&offers.length>0&&<div className="section"><div className="section-head"><h2><Siren size={19}/> Nearby SOS offers</h2><span className="pill red">{offers.length} awaiting response</span></div><div className="mission-list">{offers.map(o=><div className="mission-row" key={o.id}><div className="mission-icon red"><Siren/></div><div><strong>{o.mission.category}</strong><small>{o.mission.description}</small></div><button className="primary" onClick={()=>void run(async()=>{await api('/offers/'+o.id+'/accept','POST');await refresh()})}>Accept mission</button></div>)}</div></div>}<div className="dashboard-grid"><div className="section"><div className="section-head"><h2>Recent missions</h2><button className="link" onClick={()=>setView('missions')}>View all <ArrowRight size={16}/></button></div><div className="mission-list">{all.length?all.slice(0,4).map(m=><MissionRow key={m.id} m={m} onClick={()=>{setSelected(m);setView('detail')}}/>):<div className="empty"><ClipboardList size={30}/><strong>No missions yet</strong><p>When requests arrive, they will appear here.</p></div>}</div></div><div className="section response-preview"><div className="section-head"><h2>Response network</h2><span className="pill green"><span className="live-dot"/> LIVE</span></div><MapCanvas missions={all.filter(x=>x.latitude!=null)}/><div className="preview-foot"><span><MapPin size={15}/> {all.filter(x=>x.latitude!=null).length} mapped missions</span><button className="link" onClick={()=>setView('map')}>Explore map <ArrowRight size={15}/></button></div></div></div></>}
 {view==='missions'&&<><PageHead kicker="MISSION MANAGEMENT" title="Mission workspace" subtitle="Follow every request from first contact to verified impact." action={user.role==='resident'?<button className="primary" onClick={()=>setView('new')}><Plus size={18}/> New request</button>:undefined}/><div className="filters">{['all','pending','assigned','in_progress','reported_complete','confirmed'].map(x=><button key={x} className={filter===x?'selected':''} onClick={()=>setFilter(x)}>{label(x)}</button>)}</div><div className="mission-list large">{all.filter(x=>filter==='all'||x.status===filter).map(m=><MissionRow key={m.id} m={m} onClick={()=>{setSelected(m);setView('detail')}}/>)}{all.filter(x=>filter==='all'||x.status===filter).length===0&&<div className="empty">No missions match this filter.</div>}</div></>}
 {view==='new'&&<><PageHead kicker="REQUEST ASSISTANCE" title="Tell us what you need" subtitle="Share a few details so community volunteers can respond."/><div className="form-card"><label>Assistance category<select value={category} onChange={e=>setCategory(e.target.value)}>{categories.map(c=><option key={c}>{c}</option>)}</select></label><label>Describe the situation<textarea rows={5} value={description} onChange={e=>setDescription(e.target.value)} placeholder="What assistance would help?"/></label><label>Priority<select value={priority} onChange={e=>setPriority(e.target.value)}><option value="standard">Standard</option><option value="high">High</option><option value="critical">Critical</option></select></label><p className="muted"><LocateFixed size={16}/> Browser location permission is requested only when submitting.</p><button className="primary" disabled={busy||description.trim().length<2} onClick={()=>void create(false)}>Submit assistance request <ArrowRight size={16}/></button></div></>}
 {view==='map'&&<><PageHead kicker="LIVE RESPONSE INTELLIGENCE" title="Rescue command map" subtitle="An operational view of consent-shared incident locations and mission progress."/><div className="command-layout"><div className="command-sidebar"><div className="command-header"><div className="eyebrow">INCIDENT INTELLIGENCE</div><h3>Active response board</h3><p>{all.length} missions in this workspace</p></div><div className="command-cards">{all.filter(x=>x.latitude!=null).map(m=><button className="incident-card" key={m.id} onClick={()=>{setSelected(m);setView('detail')}}><span className={'severity '+(m.priority==='critical'?'critical':'')}>{m.priority.toUpperCase()}</span><strong>{m.category}</strong><small>{label(m.status)} · {fmt(m.created_at)}</small><span>View mission <ArrowRight size={14}/></span></button>)}{!all.some(x=>x.latitude!=null)&&<p className="muted">No GPS-enabled incidents yet.</p>}</div></div><div className="command-map"><div className="map-overlay"><span className="live-dot"/> RESPONSE NETWORK <span>· {all.filter(x=>x.latitude!=null).length} LOCATIONS</span></div><MapCanvas missions={all.filter(x=>x.latitude!=null)}/><div className="map-legend"><span><i className="red-dot"/> SOS</span><span><i className="teal-dot"/> Volunteer</span><span><i className="amber-dot"/> Pending</span></div></div></div></>}
 {view==='detail'&&selected&&<><button className="back" onClick={()=>{setSelected(null);setView('missions')}}>← All missions</button><PageHead kicker={'MISSION · '+selected.id.slice(0,8).toUpperCase()} title={selected.category} subtitle={selected.description}/><div className="detail-meta"><span className={'pill '+(selected.priority==='critical'?'red':'amber')}>{selected.priority.toUpperCase()} PRIORITY</span><span className="pill blue">{label(selected.status)}</span><span>{fmt(selected.created_at)}</span></div><div className="detail-layout"><div><div className="section map-section"><div className="section-head"><h2><Navigation size={19}/> Mission navigation</h2><span className="pill green"><Radio size={14}/> {tracking?.volunteer?'LIVE LOCATION':'AWAITING LOCATION'}</span></div><div className="mission-map"><MapCanvas resident={tracking?.resident} volunteer={tracking?.volunteer}/></div><div className="route-stats"><div><small>ROAD DISTANCE</small><strong>{route?(route.distance/1000).toFixed(2)+' km':'—'}</strong></div><div><small>ESTIMATED DRIVE</small><strong>{route?Math.ceil(route.duration/60)+' min':'—'}</strong></div><div><small>GPS STATUS</small><strong>{tracking?.volunteer?'Fresh':'Unavailable'}</strong></div></div><p className="muted tiny">Routing uses public demonstration infrastructure; no traffic prediction or guaranteed ETA. Volunteer location expires after 2 minutes without an update.</p>{user.role==='volunteer'&&selected.volunteer_id===user.id&&<button className={sharing?'outline':'primary'} onClick={()=>sharing?void stopSharing():setSharing(true)}>{sharing?<><Square size={16}/> Stop sharing</>:<><LocateFixed size={16}/> Share my location</>}</button>}</div><div className="section"><div className="section-head"><h2><MessageCircle size={19}/> Mission conversation</h2><span className="pill blue">Polling every 12s</span></div><div className="chat-log">{messages.length?messages.map(m=><div className={'bubble '+(m.sender_id===user.id?'mine':'')} key={m.id}><p>{m.body}</p><small>{fmt(m.created_at)}</small></div>):<div className="empty"><MessageCircle size={28}/><p>No messages yet. Start the conversation.</p></div>}</div><form className="chat-form" onSubmit={sendMessage}><input value={draft} onChange={e=>setDraft(e.target.value)} placeholder="Write a message..."/><button className="primary" disabled={!draft.trim()}><Send size={17}/></button></form><p className="muted tiny">Messages use the SAHARA API and periodic refresh. Calling uses browser WebRTC, not the Nexconn Call SDK.</p></div></div><div><div className="section action-panel"><h2>Mission controls</h2><p>Actions are role-checked and recorded in the mission state.</p>{user.role==='volunteer'&&selected.status==='assigned'&&<button className="primary wide" onClick={()=>void updateStatus('in_progress')}>Start mission <ArrowRight size={16}/></button>}{user.role==='volunteer'&&selected.status==='in_progress'&&<button className="primary wide" onClick={()=>void updateStatus('reported_complete')}>Report completion <Check size={16}/></button>}{user.role==='resident'&&selected.status==='reported_complete'&&<button className="primary wide" onClick={()=>void updateStatus('confirmed')}>Verify help received <Check size={16}/></button>}{user.role==='resident'&&selected.status==='reported_complete'&&<button className="outline wide" onClick={()=>void updateStatus('disputed')}>Report an issue</button>}{user.role==='resident'&&['pending','assigned','in_progress'].includes(selected.status)&&<button className="danger-outline wide" onClick={()=>confirm('Cancel this mission?')&&void updateStatus('cancelled')}>Cancel request</button>}<div className="emergency-card"><Phone size={19}/><div><strong>Emergency assistance</strong><p>In immediate danger, contact official services.</p><a href="tel:112">Call 112 <ArrowRight size={14}/></a></div></div></div><CallPanel key={selected.id} missionId={selected.id} token={token} enabled={!!selected.volunteer_id&&['assigned','in_progress'].includes(selected.status)}/><div className="section"><h2>Mission timeline</h2><div className="timeline"><div><span/> Request submitted <small>{fmt(selected.created_at)}</small></div>{selected.volunteer_id&&<div><span/> Volunteer assigned</div>}{selected.status!=='pending'&&<div><span/> Current: {label(selected.status)}</div>}</div></div></div></div></>}
 {view==='messages'&&<><PageHead kicker="COMMUNICATIONS" title="Mission conversations" subtitle="Select a mission to open its private conversation."/><div className="mission-list large">{all.map(m=><MissionRow key={m.id} m={m} onClick={()=>{setSelected(m);setView('detail')}}/>)}</div></>}
 {view==='impact'&&<><PageHead kicker="THE IMPACT NETWORK" title="Every act of help matters." subtitle="Meaningful recognition for verified community service."/><div className="impact-hero"><div className="eyebrow">YOUR IMPACT SCORE</div><strong>{user.points||0}</strong><span>SAHARA POINTS</span><p>100 points are awarded after a resident confirms successful help. Points have no monetary value.</p></div><div className="stat-grid"><Stat icon={CheckCircle2} label="Verified missions" value={completed} tint="mint"/><Stat icon={Star} label="Your points" value={user.points||0} tint="amber"/><Stat icon={HeartHandshake} label="Community contribution" value="Growing" tint="purple"/></div></>}
 {view==='safety'&&<><PageHead kicker="TRUST & SAFETY" title="Safety comes first." subtitle="Humanitarian technology should protect people, not put them at risk."/><div className="safety-grid">{[{icon:Phone,title:'Official emergency response',text:'SAHARA is not an ambulance, police, fire or emergency dispatch service. In India, call 112 for immediate danger.'},{icon:LocateFixed,title:'Consent-based location',text:'Browser permission is required for GPS. Live volunteer coordinates expire from mission views after two minutes.'},{icon:Shield,title:'Role-based access',text:'Mission locations and messages are available only to authorized participants and coordinators.'},{icon:HeartHandshake,title:'Volunteer boundaries',text:'Never accept a mission that requires training or equipment you do not possess.'}].map(x=><div className="safety-card" key={x.title}><x.icon size={24}/><h3>{x.title}</h3><p>{x.text}</p></div>)}</div></>}
 </main><footer>SAHARA RESCUE INTELLIGENCE <span>Independent prototype · Not an emergency dispatch service</span></footer></div></div>;
}
function Stat({icon:Icon,label,value,tint}:{icon:typeof Activity;label:string;value:number|string;tint:string}){return <div className="stat"><div className={'stat-icon '+tint}><Icon size={22}/></div><strong>{value}</strong><span>{label}</span><div className="stat-bar"/></div>}
function PageHead({kicker,title,subtitle,action}:{kicker:string;title:string;subtitle:string;action?:React.ReactNode}){return <div className="page-head"><div><div className="eyebrow">{kicker}</div><h1>{title}</h1><p>{subtitle}</p></div>{action}</div>}
function MissionRow({m,onClick}:{m:Mission;onClick:()=>void}){return <button className="mission-row" onClick={onClick}><div className={'mission-icon '+(m.priority==='critical'?'red':'')}><HeartHandshake size={21}/></div><div className="mission-text"><strong>{m.category}</strong><small>{m.description}</small></div><span className={'pill '+(m.status==='pending'?'amber':'blue')}>{label(m.status)}</span><span className="mission-date">{fmt(m.created_at)}</span><ArrowRight size={18}/></button>}
